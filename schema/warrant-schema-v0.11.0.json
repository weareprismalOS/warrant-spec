{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://warrant.dev/schema/v0.11.0/warrant.schema.json",
  "title": "WARRANT Intent Blueprint",
  "description": "Formal JSON Schema (v0.11.0) for the WARRANT standard. Defines a flattened 14-Pillar structure with each Pillar as a dedicated root-level property. Validates pre-deployment boundaries and permissions for autonomous agents. Licensed under CC BY 4.0.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-[a-z]+-": {} },
  "properties": {
    "x-mcp-context": {
      "description": "Optional MCP context injection metadata. Any MCP-compliant agent runtime or developer tool can inject a WARRANT blueprint as a context extension without custom code.",
      "type": "object"
    }
  },
  "required": [
    "warrant_version",
    "manifest",
    "objective",
    "ux_logic",
    "feasibility",
    "stakeholders",
    "compliance_frameworks",
    "risk_profile",
    "data_model",
    "boundaries",
    "integration_map",
    "success_metrics",
    "failure_modes",
    "personas",
    "runtime_observability"
  ],
  "properties": {
    "warrant_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$",
      "description": "The specification version this document conforms to. Validates against semantic versioning (major.minor.patch with optional pre-release suffix)."
    },
    "agent_id": {
      "type": "string",
      "description": "URI or DID identifying the agent this blueprint governs."
    },
    "agent_name": {
      "type": "string",
      "description": "Human-readable name of the agent."
    },
    "conformance_level": {
      "type": "string",
      "enum": ["L1", "L2", "L3", "L4"],
      "description": "Declared conformance level. When present, triggers conditional validation for the declared level."
    },

    "manifest": {
      "type": "object",
      "description": "Pillar 01: Manifest — administrative metadata for the Intent Blueprint. Renamed from v0.9.15 'metadata'.",
      "additionalProperties": false,
      "patternProperties": { "^x-[a-z]+-": {} },
      "required": [
        "blueprint_id",
        "version",
        "owner",
        "status",
        "created_at"
      ],
      "properties": {
        "blueprint_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,254}$",
          "description": "Unique identifier. Must begin with alphanumeric. Max 255 chars."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic versioning (e.g., 1.0.0) of this specific intent blueprint."
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Should be a URI or DID representing the human authority."
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "deprecated",
            "archived"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of the most recent modification. MUST be updated whenever the blueprint is re-versioned."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Human-readable name for the project or workflow."
        },
        "extends": {
          "type": "object",
          "description": "Inheritance mechanism mapping to a parent document.",
          "additionalProperties": false,
          "required": [
            "uri",
            "array_merge_strategy"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "array_merge_strategy": {
              "type": "string",
              "enum": [
                "append",
                "replace",
                "intersect"
              ],
              "description": "Explicit instruction for the Validator on how to resolve array conflicts. Note: 'append' is strictly forbidden for permission arrays."
            }
          }
        },
        "lifecycle_management": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "versioning_policy": {
              "type": "string"
            },
            "review_cadence": {
              "type": "string"
            },
            "deprecation_policy": {
              "type": "string"
            }
          }
        },
        "ledger_anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network",
            "anchor_hash"
          ],
          "properties": {
            "network": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
              "description": "MUST be a valid CAIP-2 identifier (e.g., eip155:1)."
            },
            "anchor_hash": {
              "type": "string",
              "pattern": "^[a-z0-9]+:[a-f0-9]+$",
              "description": "MUST be a prefixed hash (e.g., sha256:<hex>)."
            }
          }
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signed_by",
            "hash",
            "algorithm"
          ],
          "properties": {
            "signed_by": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "SHA-256 hash. Hex-encoded, lowercase, exactly 64 characters."
            },
            "algorithm": {
              "type": "string",
              "enum": [
                "EdDSA",
                "RS256",
                "ES256"
              ],
              "description": "The cryptographic algorithm used to generate the signature."
            }
          }
        },
        "discovery_uri": {
          "type": "string",
          "format": "uri",
          "description": "URI from which the canonical JSON representation of this Intent Blueprint can be retrieved."
        },
        "discovery_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["well_known_endpoint"],
          "properties": {
            "well_known_endpoint": {
              "type": "string",
              "format": "uri",
              "description": "URI of the .well-known/warrant-discovery endpoint."
            },
            "refresh_interval_seconds": {
              "type": "integer",
              "minimum": 60,
              "description": "How often the discovery index is refreshed."
            }
          }
        }
      }
    },

    "objective": {
      "type": "object",
      "description": "Pillar 02: Objective — consolidated from v0.9.15 intent fields (primary_objective, domain, autonomy_level, success_criteria, out_of_scope).",
      "required": [
        "primary_objective",
        "success_criteria",
        "out_of_scope"
      ],
      "properties": {
        "primary_objective": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "autonomy_level": {
          "type": "string",
          "enum": [
            "supervised",
            "autonomous",
            "human_in_the_loop"
          ]
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ux_logic": {
      "type": "object",
      "description": "Pillar 03: UX Logic — behavioural rules governing agent-user interaction. Lifted from v0.9.15 intent.ux_logic.",
      "properties": {
        "interaction_model": {
          "type": "string",
          "enum": ["autonomous", "notify", "approve", "escalate"],
          "description": "Default user-facing interaction tier."
        },
        "user_facing": {
          "type": "boolean",
          "description": "Whether this agent produces outputs visible to end users."
        },
        "tone_and_voice": {
          "type": "string",
          "description": "Communication style the agent must adopt when user-facing."
        },
        "edge_case_handling": {
          "type": "string",
          "description": "Instructions for behaviour when encountering unanticipated situations."
        },
        "failure_ux": {
          "type": "string",
          "description": "What the agent must communicate when it cannot complete its task."
        },
        "explainability_uri": {
          "type": "string",
          "format": "uri",
          "description": "URI pointing to the agent's reasoning trace or explanation endpoint."
        }
      }
    },

    "feasibility": {
      "type": "object",
      "description": "Pillar 04: Feasibility — resource constraints and hard stops. Consolidated from v0.9.15 permissions.feasibility + permissions.active_period + permissions.top_up_config (formerly budget_cap).",
      "properties": {
        "budget_limit": {
          "type": "object",
          "description": "Cross-Pillar Invariant 2: risk_profile.financial_risk_limit.amount MUST NOT exceed this amount (same-currency comparison).",
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217 currency code." },
            "time_period": { "type": "string" }
          }
        },
        "compute_constraints": { "type": "string" },
        "timeline": { "type": "string" },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "hard_stops": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Condition strings that, if met, halt the agent."
        },
        "active_period": {
          "type": "object",
          "required": ["timezone", "window_start", "window_end"],
          "properties": {
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "days": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "Monday",
                  "Tuesday",
                  "Wednesday",
                  "Thursday",
                  "Friday",
                  "Saturday",
                  "Sunday"
                ]
              }
            },
            "window_start": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$"
            },
            "window_end": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$"
            }
          }
        },
        "top_up_config": {
          "description": "Top-up configuration — defines the protocol for budget top-up requests. Renamed from v0.9.15 budget_cap to reflect sole remaining purpose after daily_limit_eur removal.",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": { "^x-[a-z]+-": {} },
          "properties": {
            "top_up_protocol": {
              "type": "object",
              "required": ["protocol_uri", "max_top_up_amount", "approval_required"],
              "properties": {
                "protocol_uri": {
                  "type": "string",
                  "format": "uri"
                },
                "max_top_up_amount": {
                  "type": "number",
                  "minimum": 0
                },
                "approval_required": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "patternProperties": { "^x-[a-z]+-": {} }
            }
          }
        }
      }
    },

    "stakeholders": {
      "type": "object",
      "description": "Pillar 05: Stakeholders — lifted from v0.9.15 permissions.stakeholders.",
      "properties": {
        "approvers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Identifiers (URIs or DIDs) of stakeholders who must approve the blueprint. Cross-Pillar Invariant 3: no persona with trust_level 'zero' may appear here."
        },
        "notification_list": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "compliance_frameworks": {
      "type": "object",
      "description": "Pillar 06: Compliance Frameworks — wraps v0.9.15 compliance.frameworks.",
      "properties": {
        "frameworks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "controls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["control_id", "pillars"],
                  "additionalProperties": false,
                  "properties": {
                    "control_id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Identifier of the framework clause or control (e.g., 'Art. 9(1)')."
                    },
                    "pillars": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "enum": [
                          "manifest", "objective", "ux_logic", "feasibility",
                          "stakeholders", "compliance_frameworks", "risk_profile",
                          "data_model", "boundaries", "integration_map",
                          "success_metrics", "failure_modes", "personas",
                          "runtime_observability"
                        ]
                      },
                      "description": "WARRANT Pillars that address this control."
                    }
                  }
                }
              }
            }
          }
        },
        "crosswalks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["framework", "mappings"],
            "additionalProperties": false,
            "properties": {
              "framework": {
                "type": "string",
                "minLength": 1,
                "description": "Regulatory framework identifier (e.g., 'EU AI Act', 'ISO 42001')."
              },
              "mappings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["regulation_clause", "warrant_pillar"],
                  "additionalProperties": false,
                  "properties": {
                    "regulation_clause": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Specific clause or section of the regulatory framework."
                    },
                    "warrant_pillar": {
                      "type": "string",
                      "enum": [
                        "manifest", "objective", "ux_logic", "feasibility",
                        "stakeholders", "compliance_frameworks", "risk_profile",
                        "data_model", "boundaries", "integration_map",
                        "success_metrics", "failure_modes", "personas",
                        "runtime_observability"
                      ]
                    },
                    "coverage_status": {
                      "type": "string",
                      "enum": ["full", "partial", "planned"],
                      "description": "Coverage status of this mapping."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "risk_profile": {
      "type": "object",
      "description": "Pillar 07: Risk Profile — consolidated from v0.9.15 boundaries.hitl_triggers + permissions.on_failure.",
      "properties": {
        "hitl_triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "threshold",
              "operator",
              "action"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "threshold": {
                "type": "number"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "lt",
                  "gt",
                  "eq",
                  "lte",
                  "gte"
                ]
              },
              "action": {
                "type": "string",
                "enum": [
                  "pause_and_verify",
                  "escalate",
                  "halt",
                  "request_reauthentication",
                  "notify_only"
                ]
              }
            }
          }
        },
        "on_failure": {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": {
              "type": "string",
              "enum": [
                "escalate",
                "halt",
                "retry"
              ]
            },
            "failure_ux": {
              "type": "string"
            },
            "edge_case_handling": {
              "type": "string"
            },
            "escalation_path": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "retry_policy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max_retries": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "backoff": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "exponential",
                    "fixed"
                  ]
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "default": { "const": "retry" } },
                "required": ["default"]
              },
              "then": {
                "required": ["retry_policy"]
              }
            },
            {
              "if": {
                "properties": { "default": { "const": "escalate" } },
                "required": ["default"]
              },
              "then": {
                "required": ["escalation_path"]
              }
            }
          ]
        },
        "alert_endpoint": {
          "type": "string",
          "format": "uri",
          "description": "URI to which the Enforcement Engine sends real-time notifications when risk thresholds are breached."
        },
        "alert_format": {
          "type": "string",
          "enum": ["webhook", "syslog", "cloudevents"],
          "description": "Format of alert payloads sent to alert_endpoint."
        },
        "drift_detection": {
          "type": "object",
          "required": ["threshold", "action"],
          "additionalProperties": false,
          "properties": {
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Maximum acceptable divergence score (0 = no drift, 1 = complete divergence)."
            },
            "action": {
              "type": "string",
              "enum": ["alert", "pause", "halt"],
              "description": "Action to take when observed divergence exceeds threshold."
            },
            "evaluation_interval": {
              "type": "string",
              "enum": ["every_request", "hourly", "daily", "weekly"],
              "description": "Frequency of drift evaluation."
            }
          }
        },
        "governance_workflow": {
          "type": "object",
          "required": ["auto_approve_policy", "exception_routing"],
          "additionalProperties": false,
          "properties": {
            "auto_approve_policy": {
              "type": "string",
              "enum": ["all_within_bounds", "low_risk_only", "none"],
              "description": "Which categories of agent actions are automatically approved."
            },
            "exception_routing": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["condition", "route_to"],
                "additionalProperties": false,
                "properties": {
                  "condition": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Exception trigger condition."
                  },
                  "route_to": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Human or team identifier for exception review."
                  }
                }
              }
            },
            "review_sla_seconds": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum time for human review before on_failure action triggers."
            }
          }
        },
        "financial_risk_limit": {
          "type": "object",
          "description": "Cross-Pillar Invariant 2: financial_risk_limit.amount MUST NOT exceed feasibility.budget_limit.amount (same-currency comparison).",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "ISO 4217 currency code."
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["alert_endpoint"] },
          "then": { "required": ["alert_format"] }
        }
      ]
    },

    "data_model": {
      "type": "object",
      "description": "Pillar 08: Data Model — consolidated from v0.9.15 permissions.data_model + permissions.data_access + permissions.data_write + permissions.data_forbidden.",
      "properties": {
        "data_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "data_outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "retention_policy": {
          "type": "string"
        },
        "sensitive_data_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data_ownership": {
          "type": "string"
        },
        "data_access": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" },
          "description": "Data sources the agent is authorized to read. Deny-by-default: unlisted sources are forbidden."
        },
        "data_write": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" },
          "description": "Data targets the agent is authorized to write to. Deny-by-default: unlisted targets are forbidden."
        },
        "data_forbidden": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" },
          "description": "Data resources explicitly forbidden. Overrides data_access and data_write."
        },
        "data_sovereignty_region": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code declaring the jurisdiction for data residency."
        }
      }
    },
    "boundaries": {
      "type": "object",
      "description": "Pillar 09: Boundaries — narrowed to prohibited actions, scope boundaries, and kill switch only. hitl_triggers moved to risk_profile, failure_modes moved to failure_modes root-level property.",
      "properties": {
        "prohibited_actions": {
          "type": "array",
          "description": "Structured, machine-enforceable negative constraints. Cross-Pillar Invariant 4: no prohibited action pattern may match an authorised integration URI.",
          "items": {
            "type": "object",
            "required": [
              "resource_pattern",
              "methods",
              "description"
            ],
            "properties": {
              "resource_pattern": {
                "type": "string",
                "minLength": 1,
                "format": "regex",
                "description": "Regex or strict URI representing the forbidden target (e.g., '^mcp://unverified-exchange/.*')."
              },
              "methods": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "DELETE",
                    "PATCH",
                    "TRADE",
                    "EXECUTE",
                    "READ",
                    "WRITE",
                    "*"
                  ]
                },
                "description": "The specific tool calls or HTTP methods forbidden on this resource. '*' is the canonical wildcard."
              },
              "description": {
                "type": "string",
                "description": "Human-readable intent behind this enforcement boundary."
              }
            }
          }
        },
        "scope_boundaries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Pillar 09: Explicit limits on what any agent may do, regardless of instruction."
        },
        "kill_switch": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "api_endpoint",
                "smart_contract",
                "manual"
              ]
            },
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "contract_address": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "smart_contract"
                  }
                }
              },
              "then": {
                "required": [
                  "contract_address"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "api_endpoint"
                  }
                }
              },
              "then": {
                "required": [
                  "uri"
                ]
              }
            }
          ]
        }
      }
    },
    "integration_map": {
      "type": "object",
      "description": "Pillar 10: Integration Map — consolidated from v0.9.15 permissions.integration_map + permissions.tool_access + permissions.tool_forbidden.",
      "properties": {
        "authorised_integrations": {
          "type": "array",
          "uniqueItems": true,
          "description": "Cross-Pillar Invariant 1: every integration here MUST have a corresponding failure scenario in failure_modes.known_failure_modes. Cross-Pillar Invariant 4: no prohibited action pattern may match a URI here. Items may be legacy URI strings (deprecated) or enriched objects.",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "format": "uri",
                "description": "DEPRECATED in v0.11.0. Plain URI string format. Will be removed in v1.0.0."
              },
              {
                "type": "object",
                "required": ["uri", "justification"],
                "additionalProperties": false,
                "properties": {
                  "uri": {
                    "type": "string",
                    "format": "uri",
                    "description": "Integration endpoint URI."
                  },
                  "justification": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Human-readable justification for why this integration is authorised."
                  },
                  "protocol_version": {
                    "type": "string",
                    "description": "Optional version pin for the integration protocol."
                  }
                }
              }
            ]
          }
        },
        "rate_limits": {
          "type": "object",
          "required": [
            "requests",
            "window_seconds"
          ],
          "properties": {
            "requests": {
              "type": "integer",
              "minimum": 1
            },
            "window_seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "patternProperties": { "^x-[a-z]+-": {} }
        },
        "warrant_handshake": {
          "type": "boolean"
        },
        "failure_handling": {
          "type": "string",
          "minLength": 1,
          "description": "How the agent MUST behave when an authorised integration is unavailable or returns an error."
        },
        "handshake_failure_handling": {
          "type": "string",
          "minLength": 1,
          "description": "CONDITIONAL. REQUIRED if warrant_handshake is true. How the agent MUST behave if the warrant handshake itself fails."
        },
        "tool_access": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" },
          "description": "Tools and APIs the agent is authorized to use. Supports mcp:// URIs. Deny-by-default: unlisted tools are forbidden. Cross-Pillar Invariant 1: every tool here MUST have a corresponding failure scenario."
        },
        "tool_forbidden": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" },
          "description": "Tools explicitly forbidden. Overrides tool_access."
        }
      },
      "if": {
        "required": ["warrant_handshake"],
        "properties": { "warrant_handshake": { "const": true } }
      },
      "then": {
        "required": ["handshake_failure_handling"]
      }
    },

    "success_metrics": {
      "type": "object",
      "description": "Pillar 11: Success Metrics — lifted from v0.9.15 compliance.success_metrics. All internal constraints preserved.",
      "required": [
        "primary_kpi",
        "baseline",
        "measurement_frequency",
        "evidence_pack_config"
      ],
      "properties": {
        "primary_kpi": {
          "type": "string",
          "minLength": 1
        },
        "secondary_kpis": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "measurement_frequency": {
          "type": "string",
          "enum": ["hourly", "daily", "weekly", "monthly", "quarterly", "annually", "on_demand"],
          "description": "How often metrics MUST be reported."
        },
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "degradation_threshold": {
          "type": "string"
        },
        "evidence_pack_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["storage", "retention_days"],
          "properties": {
            "storage": {
              "type": "string",
              "format": "uri"
            },
            "retention_days": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "kpis": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["metric_id"],
            "additionalProperties": false,
            "properties": {
              "metric_id": {
                "type": "string",
                "minLength": 1,
                "description": "Unique identifier for this KPI. Referenced by runtime_observability.guardian_alerts[].metric_ref."
              },
              "description": {
                "type": "string",
                "description": "Human-readable description of the KPI."
              }
            }
          }
        }
      }
    },
    "failure_modes": {
      "type": "object",
      "description": "Pillar 12: Failure Modes — lifted from v0.9.15 boundaries.failure_modes.",
      "properties": {
        "known_failure_modes": {
          "type": "array",
          "description": "Cross-Pillar Invariant 1: every integration in integration_map MUST have a corresponding failure scenario here.",
          "items": {
            "type": "object",
            "required": ["scenario", "severity", "mitigation"],
            "properties": {
              "scenario": { "type": "string", "minLength": 1 },
              "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
              "mitigation": { "type": "string", "minLength": 1 },
              "related_integration": {
                "type": "string",
                "format": "uri",
                "description": "URI of the integration this failure scenario corresponds to. Used by Invariant 1 (Integration ↔ Failure Modes) for matching."
              }
            }
          }
        },
        "circuit_breaker": {
          "type": "object",
          "required": ["failure_threshold", "half_open_after_seconds", "success_threshold"],
          "additionalProperties": false,
          "properties": {
            "failure_threshold": {
              "type": "integer",
              "minimum": 1,
              "description": "Consecutive failures before circuit opens."
            },
            "half_open_after_seconds": {
              "type": "integer",
              "minimum": 1,
              "description": "Seconds before circuit transitions from open to half-open."
            },
            "success_threshold": {
              "type": "integer",
              "minimum": 1,
              "description": "Consecutive successes in half-open state before circuit closes."
            },
            "on_open": {
              "type": "string",
              "enum": ["halt", "fallback", "escalate"],
              "description": "Action when circuit opens."
            }
          }
        },
        "assumption_risks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "external_dependencies_risk": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "edge_cases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "on_failure": {
          "type": "object",
          "required": ["default"],
          "description": "Planning-level failure handler. See Section 8.6: risk_profile.on_failure takes precedence at runtime.",
          "properties": {
            "default": { "type": "string", "enum": ["escalate", "halt", "retry"] },
            "escalation_path": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "Ordered list of humans or systems to escalate to. REQUIRED when default is 'escalate'."
            },
            "retry_policy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max_retries": { "type": "integer", "minimum": 1, "maximum": 100 },
                "backoff": { "type": "string", "enum": ["linear", "exponential", "fixed"] }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "default": { "const": "retry" } },
                "required": ["default"]
              },
              "then": {
                "required": ["retry_policy"]
              }
            },
            {
              "if": {
                "properties": { "default": { "const": "escalate" } },
                "required": ["default"]
              },
              "then": {
                "required": ["escalation_path"]
              }
            }
          ]
        }
      }
    },
    "personas": {
      "type": "array",
      "description": "Pillar 13: Personas — unchanged from v0.9.15.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "trust_level"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,126}$",
            "description": "Unique persona identifier. Max 127 chars, alphanumeric start."
          },
          "trust_level": {
            "type": "string",
            "enum": [
              "zero",
              "supervised",
              "low",
              "standard",
              "semi-autonomous",
              "high",
              "autonomous"
            ],
            "description": "Cross-Pillar Invariant 3: personas with trust_level 'zero' MUST NOT appear in stakeholders.approvers."
          },
          "capabilities_override": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": { "^x-[a-z]+-": {} },
            "properties": {
              "deny_all_writes": {
                "type": "boolean"
              },
              "restrict_tool_access": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "runtime_observability": {
      "type": "object",
      "description": "Pillar 14: Runtime Observability — consolidates intent traceability, heartbeat, and guardian alert configuration.",
      "additionalProperties": false,
      "patternProperties": { "^x-[a-z]+-": {} },
      "properties": {
        "intent_traceability": {
          "type": "object",
          "required": ["reasoning_manifest_uri", "log_format"],
          "additionalProperties": false,
          "properties": {
            "reasoning_manifest_uri": {
              "type": "string",
              "format": "uri",
              "description": "Endpoint where the agent publishes structured reasoning logs."
            },
            "log_format": {
              "type": "string",
              "enum": ["json", "opentelemetry", "custom"],
              "description": "Format of reasoning trace entries."
            },
            "log_retention_days": {
              "type": "integer",
              "minimum": 1,
              "description": "How long reasoning logs must be retained."
            }
          }
        },
        "heartbeat": {
          "type": "object",
          "required": ["broadcast_uri", "interval_seconds"],
          "additionalProperties": false,
          "properties": {
            "broadcast_uri": {
              "type": "string",
              "format": "uri",
              "description": "Endpoint to which the agent sends heartbeat signals."
            },
            "interval_seconds": {
              "type": "integer",
              "minimum": 10,
              "description": "Frequency of heartbeat broadcasts in seconds. Enforcement Engines SHOULD apply ±10% random jitter."
            }
          }
        },
        "guardian_alerts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["metric_ref", "threshold", "operator", "action"],
            "additionalProperties": false,
            "properties": {
              "metric_ref": {
                "type": "string",
                "minLength": 1,
                "description": "Identifier referencing a KPI in success_metrics.kpis[].metric_id. Cross-Pillar Invariant 5."
              },
              "threshold": {
                "type": "number",
                "description": "Threshold value for the alert."
              },
              "operator": {
                "type": "string",
                "enum": ["lt", "gt", "eq", "lte", "gte"],
                "description": "Comparison operator."
              },
              "action": {
                "type": "string",
                "enum": ["alert", "pause", "halt", "escalate"],
                "description": "Action to take when threshold is breached."
              }
            }
          }
        }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "properties": { "conformance_level": { "const": "L1" } },
        "required": ["conformance_level"]
      },
      "then": {
        "properties": {
          "manifest": { "required": ["blueprint_id", "version", "owner", "status", "created_at"] },
          "objective": { "required": ["domain", "autonomy_level"] },
          "compliance_frameworks": { "required": ["frameworks"] },
          "risk_profile": {
            "required": ["hitl_triggers", "on_failure"],
            "properties": { "hitl_triggers": { "minItems": 1 } }
          },
          "boundaries": {
            "required": ["scope_boundaries", "prohibited_actions"],
            "properties": { "scope_boundaries": { "minItems": 1 } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "conformance_level": { "const": "L2" } },
        "required": ["conformance_level"]
      },
      "then": {
        "properties": {
          "manifest": {
            "required": ["blueprint_id", "version", "owner", "status", "created_at"],
            "properties": { "status": { "enum": ["active", "deprecated", "archived"] } }
          },
          "objective": { "required": ["domain", "autonomy_level"] },
          "ux_logic": { "required": ["interaction_model", "user_facing"] },
          "feasibility": { "required": ["budget_limit"] },
          "stakeholders": {
            "required": ["approvers"],
            "properties": { "approvers": { "minItems": 1 } }
          },
          "compliance_frameworks": { "required": ["frameworks"] },
          "risk_profile": {
            "required": ["hitl_triggers", "on_failure"],
            "properties": { "hitl_triggers": { "minItems": 1 } }
          },
          "data_model": { "required": ["data_sources"] },
          "boundaries": {
            "required": ["kill_switch", "scope_boundaries", "prohibited_actions"],
            "properties": { "scope_boundaries": { "minItems": 1 } }
          },
          "integration_map": { "required": ["tool_access"] },
          "success_metrics": { "minProperties": 1 },
          "failure_modes": {
            "required": ["known_failure_modes"],
            "properties": { "known_failure_modes": { "minItems": 1 } }
          },
          "personas": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "conformance_level": { "const": "L3" } },
        "required": ["conformance_level"]
      },
      "then": {
        "properties": {
          "manifest": {
            "required": ["blueprint_id", "version", "owner", "status", "created_at", "signature", "discovery_uri"],
            "properties": { "status": { "enum": ["active", "deprecated", "archived"] } }
          },
          "objective": { "required": ["domain", "autonomy_level"] },
          "ux_logic": { "required": ["interaction_model", "user_facing"] },
          "feasibility": { "required": ["budget_limit"] },
          "stakeholders": {
            "required": ["approvers"],
            "properties": { "approvers": { "minItems": 1 } }
          },
          "compliance_frameworks": {
            "required": ["frameworks"],
            "properties": { "frameworks": { "minItems": 1 } }
          },
          "risk_profile": {
            "required": ["hitl_triggers", "on_failure", "alert_endpoint", "alert_format"],
            "properties": { "hitl_triggers": { "minItems": 1 } }
          },
          "data_model": { "required": ["data_sources"] },
          "boundaries": {
            "required": ["kill_switch", "scope_boundaries", "prohibited_actions"],
            "properties": { "scope_boundaries": { "minItems": 1 } }
          },
          "integration_map": { "required": ["tool_access"] },
          "success_metrics": { "minProperties": 1 },
          "failure_modes": {
            "required": ["known_failure_modes"],
            "properties": { "known_failure_modes": { "minItems": 1 } }
          },
          "personas": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "conformance_level": { "const": "L4" } },
        "required": ["conformance_level"]
      },
      "then": {
        "properties": {
          "manifest": {
            "required": ["blueprint_id", "version", "owner", "status", "created_at", "signature", "ledger_anchor", "discovery_uri"],
            "properties": { "status": { "enum": ["active", "deprecated", "archived"] } }
          },
          "objective": { "required": ["domain", "autonomy_level"] },
          "ux_logic": { "required": ["interaction_model", "user_facing"] },
          "feasibility": { "required": ["budget_limit"] },
          "stakeholders": {
            "required": ["approvers"],
            "properties": { "approvers": { "minItems": 1 } }
          },
          "compliance_frameworks": {
            "required": ["frameworks"],
            "properties": { "frameworks": { "minItems": 1 } }
          },
          "risk_profile": {
            "required": ["hitl_triggers", "on_failure", "alert_endpoint", "alert_format"],
            "properties": { "hitl_triggers": { "minItems": 1 } }
          },
          "data_model": { "required": ["data_sources"] },
          "boundaries": {
            "required": ["kill_switch", "scope_boundaries", "prohibited_actions"],
            "properties": { "scope_boundaries": { "minItems": 1 } }
          },
          "integration_map": { "required": ["tool_access"] },
          "success_metrics": { "minProperties": 1 },
          "failure_modes": {
            "required": ["known_failure_modes"],
            "properties": { "known_failure_modes": { "minItems": 1 } }
          },
          "personas": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "required": ["runtime_observability", "success_metrics"],
        "properties": {
          "runtime_observability": {
            "required": ["guardian_alerts"],
            "properties": {
              "guardian_alerts": { "minItems": 1 }
            }
          },
          "success_metrics": {
            "required": ["kpis"],
            "properties": {
              "kpis": { "minItems": 1 }
            }
          }
        }
      },
      "then": {
        "description": "Cross-Pillar Invariant 5: every guardian_alerts[].metric_ref MUST match a success_metrics.kpis[].metric_id. NOTE: JSON Schema draft-07 cannot express cross-array referential integrity natively. This invariant MUST be enforced by the Validator implementation, not by the schema alone. The schema encodes the structural precondition (both arrays present); the semantic check is implementation-level."
      }
    }
  ]
}
